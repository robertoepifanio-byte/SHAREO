{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.shareo.com.br"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "node": "22.13.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.shareo.com.br"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "node": "22.13.0"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
